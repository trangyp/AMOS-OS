      "description": "Insert generated tags into the note's YAML frontmatter tags list.",
      "side_effect": "write"
    },
    {
      "name": "auto_tag.fix_formatting",
      "description": "Co-fix common formatting issues that accompany tagging (fences, whitespace).",
      "side_effect": "write"
    },
    {
      "name": "auto_tag.reconcile_tags",
      "description": "Bulk reconcile tags across a folder or vault against a target format and scope.",
      "side_effect": "write"
    }
